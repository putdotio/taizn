{
  "name": "taizn",
  "version": "0.0.0",
  "description": "Small Samsung Tizen widget packaging and sideloading CLI.",
  "keywords": [
    "cli",
    "samsung",
    "tizen",
    "widget"
  ],
  "homepage": "https://github.com/putdotio/taizn#readme",
  "bugs": {
    "url": "https://github.com/putdotio/taizn/issues"
  },
  "license": "MIT",
  "author": "put.io <devs@put.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/putdotio/taizn.git"
  },
  "bin": {
    "taizn": "./dist/tizen-cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/tizen-cli.mts",
    "check": "vp check .",
    "clean": "rm -rf .turbo coverage dist",
    "dev": "vp pack src/tizen-cli.mts --watch",
    "prepack": "vp pack src/tizen-cli.mts",
    "test": "vp test --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "verify": "vp check . && vp pack src/tizen-cli.mts && vp test --passWithNoTests && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.20"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "pnpm@11.0.0"
}
