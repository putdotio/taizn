# Optional local defaults for taizn. Keep real values in .taizn/.env.
TAIZN_CERT_PASSWORD=<certificate-password>
TAIZN_DIST_PASSWORD=<distributor-password>
TAIZN_VARIANT=development
TAIZN_TARGET=<tv-ip>:26101
TAIZN_TIZEN_CLI=<path-to-tizen-cli>
TAIZN_SDB=<path-to-sdb>
TAIZN_SELLER_BROWSER=<path-to-google-chrome>
TAIZN_TV_HOST=<tv-ip>
TAIZN_TV_INFO_PORT=8001
TAIZN_TV_NAME=taizn
TAIZN_TV_PORT=8002
TAIZN_TV_PROTOCOL=wss
TAIZN_TV_TIMEOUT_MS=30000
TAIZN_TV_TOKEN=<paired-remote-token>
TAIZN_LIVE_PROFILE=taizn-live-test
TAIZN_LIVE_PROVE_APP=<fixture-application-id>
TAIZN_LIVE_BEACON_HOST=<computer-ip-reachable-from-tv>
TAIZN_LIVE_BEACON_TIMEOUT_MS=15000
LIVE_TEST_FETCH_URLS=<comma-separated-asset-urls>
LIVE_TEST_REMOTE_DELAY_MS=250
LIVE_TEST_REMOTE_KEYS=<comma-or-space-separated-remote-keys>
LIVE_TEST_REQUIRE_REMOTE=0
